<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TmlSteamPath Condition="'$(TmlSteamPath)' == ''">$(MSBuildProgramFiles32)\Steam\steamapps\common\tModLoader</TmlSteamPath>
  </PropertyGroup>
  <Import Project="..\tModLoader.targets" Condition="Exists('..\tModLoader.targets')" />
  <Import Project="$(TmlSteamPath)\tMLMod.targets" Condition="!Exists('..\tModLoader.targets') And Exists('$(TmlSteamPath)\tMLMod.targets')" />
  <PropertyGroup>
    <AssemblyName>BossBuildAdvisor</AssemblyName>
    <RootNamespace>BossBuildAdvisor</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>
</Project>
